{
  "$schema": "https://raw.githubusercontent.com/neutralinojs/neutralinojs/main/schemas/neutralino.config.schema.json",
  "applicationId": "com.weather.ranking",
  "version": "1.0.0",
  "defaultMode": "window",
  "port": 0,
  "documentRoot": "/",
  "url": "/index.html",
  "enableServer": true,
  "enableNativeAPI": true,
  "tokenSecurity": "one-time",
  "logging": {
    "enabled": false,
    "writeToLogFile": false
  },
  "nativeAllowlist": [
    "app.*",
    "window.*",
    "os.*"
  ],
  "modes": {
    "window": {
      "title": "天气",
      "width": 430,
      "height": 860,
      "minWidth": 360,
      "minHeight": 600,
      "fullScreen": false,
      "alwaysOnTop": false,
      "icon": "/icon.svg",
      "enableInspector": false,
      "borderless": false,
      "maximize": false,
      "hidden": false,
      "resizable": true,
      "exitProcessOnClose": true
    }
  },
  "cli": {
    "binaryName": "weather-app",
    "resourcesPath": "/",
    "extensionsPath": "/extensions/",
    "binaryVersion": "6.7.0"
  }
}